# إعدادات الخادم (Server)
PORT=5000
NODE_ENV=development

# إعدادات قاعدة البيانات (MySQL / XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=library_management
# Set to "true" when connecting to a managed MySQL provider (Aiven, Railway, TiDB Cloud, ...)
DB_SSL=false

# JSON Web Token
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=8h

# حساب المدير الافتراضي (used only by `npm run seed`)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# رفع الملفات (Uploads)
MAX_PDF_SIZE_MB=50

# رابط الواجهة الأمامية (CORS)
FRONTEND_URL=http://localhost:5173

# قفل الحساب بعد محاولات دخول فاشلة متكررة
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# حدود معدل الطلبات (Rate limiting)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=20
